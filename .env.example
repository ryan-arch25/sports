# Copy this file to .env. Both files are gitignored.

# The Odds API key: https://the-odds-api.com/
ODDS_API_KEY=your_key_here

# CollegeFootballData key, only needed for `cfb-edge scores fetch`:
# https://collegefootballdata.com/key
CFBD_API_KEY=your_key_here

# Discord webhook for --notify. Optional; the environment wins over config.toml.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
